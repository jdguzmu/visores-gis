      editorOnClickAttributesSaveButton: function() {
        //Save attrs
        var inputs = this.fieldsAttributes.getElementsByTagName("input");
        var obj = {};
        obj.name = this._editorConfig["graphicCurrent"].attributes["name"];
        obj.comment = this._editorConfig["graphicCurrent"].attributes["comment"];
