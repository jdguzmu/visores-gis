              value = parseFloat(inputs[i].value);
            }
          }
          console.log(value);
          obj[inputs[i].name] = value;
        }

        if (msg != "") {
          new Message({
            titleLabel: "Error",
            message: msg
          });
          return;
        }
        this._editorConfig["graphicCurrent"].attributes = obj;
        this.setMode('list');
      },
